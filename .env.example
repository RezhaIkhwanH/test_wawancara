# Google AI Studio API Key (Get from: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Tavily Search API Key (Get from: https://app.tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# LLM Model Configuration (Default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# MLflow Tracking Configuration
MLFLOW_EXPERIMENT_NAME=Market_News_Agentic_Evaluation
MLFLOW_DISABLE_AGENT_HINT=1

